{
  "name": "wordpdfer",
  "version": "0.2.0",
  "type": "module",
  "description": "Turn a fillable PDF (AcroForm) into a fill-in-Word document that keeps the exact form layout.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/index.ts",
    "src/lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "docx": "^9.7.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jszip": "^3.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
