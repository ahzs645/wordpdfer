{
  "name": "wordpdfer",
  "version": "0.2.0",
  "type": "module",
  "description": "Turn a fillable PDF (AcroForm) into a fill-in-Word document that keeps the exact form layout.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/index.ts",
    "src/lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "docx": "^8.5.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "jszip": "^3.10.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^3.2.4"
  }
}
